# BOB 2.0 Quantum + Granite Compiler
# Copy this file to .env and fill in your actual values

# IBM Quantum
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HF_TOKEN=your_huggingface_token_here

# Quantum Engine
QUANTUM_BACKEND=aer_simulator
# Options: aer_simulator, ibmq_qasm_simulator, ibmq_athens, ibmq_lima, etc.

# Agent & Simulation
NUM_AGENTS=10
SIMULATION_STEPS=100

# Voxel Grid (spatial discretization for sovereign runtime)
VOXEL_GRID_SIZE=32

# Assembly & Compilation
NASM_LIB_PATH=./assembly/libquantum_nasm.so

# Granite Compiler
GRANITE_TRACE=false
GRANITE_OPTIMIZE_LEVEL=2

# Logging
LOG_LEVEL=info

# Advanced (optional)
DEBUG=false
SEED=42
MAX_QUBITS=20