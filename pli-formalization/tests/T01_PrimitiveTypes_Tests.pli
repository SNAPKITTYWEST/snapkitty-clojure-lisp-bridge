/* ============================================================================
   TEST MODULE T01: PrimitiveTypes Tests
   PL/I Semantic Formalization Test Suite

   PURPOSE:
     Comprehensive test coverage for M01_PrimitiveTypes module.
     Tests all type definitions, constants, and validation procedures.
     All tests are executable logic (no stubs).

   INVARIANTS VERIFIED:
     I01: Unique object identifiers
     I19: Rollback correctness (generation monotonicity)
     I20: Receipt correspondence (mutation tracking types)

   TEST FAMILIES:
     T01.A: ObjectId validation
     T01.B: Generation validation
     T01.C: ValueKind discrimination
     T01.D: Opcode validation
     T01.E: Mutation type validation
     T01.F: Capability type validation
     T01.G: Status code validation
     T01.H: Boundary condition tests
     T01.I: Invariant assertion tests
     T01.J: Module state initialization

   AUTHOR: PL1-FORMALIZATION-ENGINEER
   DATE: 2026-07-30
   ========================================================================== */

DCL 1 T01_TestState,
    2 tests_run      FIXED BIN(31) INIT(0),
    2 tests_passed   FIXED BIN(31) INIT(0),
    2 tests_failed   FIXED BIN(31) INIT(0),
    2 last_error     CHARACTER(256) INIT(''),
    2 debug_mode     BIT(1) INIT('0'B);

/* ============================================================================
   FAMILY T01.A: ObjectId Validation Tests
   ========================================================================== */

test_object_id_valid_positive:
    PROCEDURE() RETURNS(BIT(1));
    DCL result BIT(1);
    DCL obj_id FIXED BIN(31);

    T01_TestState.tests_run = T01_TestState.tests_run + 1;

    /* Test: Small positive ObjectId should be valid */
    obj_id = 1;
    result = validate_object_id(obj_id);

    IF result = '1'B THEN
        T01_TestState.tests_passed = T01_TestState.tests_passed + 1;
        RETURN('1'B);
    ELSE
        T01_TestState.tests_failed = T01_TestState.tests_failed + 1;
        T01_TestState.last_error = 'ObjectId 1 should be valid';
        RETURN('0'B);
    END;
END test_object_id_valid_positive;

test_object_id_valid_max:
    PROCEDURE() RETURNS(BIT(1));
    DCL result BIT(1);
    DCL obj_id FIXED BIN(31);

    T01_TestState.tests_run = T01_TestState.tests_run + 1;

    /* Test: Max ObjectId should be valid */
    obj_id = MAX_OBJECT_ID;
    result = validate_object_id(obj_id);

    IF result = '1'B THEN
        T01_TestState.tests_passed = T01_TestState.tests_passed + 1;
