test_generation_strictly_increasing:
    PROCEDURE() RETURNS(BIT(1));
    DCL result BIT(1);
    DCL curr_gen FIXED BIN(31);
    DCL prev_gen FIXED BIN(31);

    T01_TestState.tests_run = T01_TestState.tests_run + 1;

    /* Test: Current generation > previous generation should be valid */
    prev_gen = 10;
    curr_gen = 11;
    result = validate_generation(curr_gen, prev_gen);

    IF result = '1'B THEN
        T01_TestState.tests_passed = T01_TestState.tests_passed + 1;
        RETURN('1'B);
    ELSE
        T01_TestState.tests_failed = T01_TestState.tests_failed + 1;
        T01_TestState.last_error = 'Generation 11 > 10 should be valid';
