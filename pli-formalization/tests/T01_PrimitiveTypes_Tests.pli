/* ============================================================================
   MASTER TEST RUNNER
   ========================================================================== */

run_all_primitive_type_tests:
    PROCEDURE RETURNS(BIT(1));
    DCL overall_result BIT(1) INIT('1'B);

    /* T01.A: ObjectId tests */
    IF NOT test_object_id_valid_positive() THEN
        overall_result = '0'B;
    END;
    IF NOT test_object_id_valid_max() THEN
        overall_result = '0'B;
    END;
    IF NOT test_object_id_invalid_zero() THEN
        overall_result = '0'B;
    END;
    IF NOT test_object_id_invalid_negative() THEN
        overall_result = '0'B;
    END;
    IF NOT test_object_id_invalid_overflow() THEN
        overall_result = '0'B;
    END;

    /* T01.B: Generation tests */
    IF NOT test_generation_strictly_increasing() THEN
        overall_result = '0'B;
    END;
    IF NOT test_generation_not_equal() THEN
        overall_result = '0'B;
    END;
    IF NOT test_generation_not_decreasing() THEN
        overall_result = '0'B;
    END;
    IF NOT test_generation_from_zero() THEN
        overall_result = '0'B;
    END;

    /* T01.C: ValueKind tests */
    IF NOT test_is_primitive_nil() THEN
        overall_result = '0'B;
    END;
    IF NOT test_is_composite_cons() THEN
        overall_result = '0'B;
    END;
    IF NOT test_primitive_excludes_composite() THEN
        overall_result = '0'B;
    END;

    /* T01.D: Opcode tests */
    IF NOT test_opcode_const_valid() THEN
        overall_result = '0'B;
    END;
    IF NOT test_opcode_halt_valid() THEN
        overall_result = '0'B;
    END;
    IF NOT test_opcode_invalid_zero() THEN
        overall_result = '0'B;
    END;
    IF NOT test_opcode_invalid_overflow() THEN
        overall_result = '0'B;
    END;

    /* T01.E: Mutation tests */
    IF NOT test_mutation_target_object_valid() THEN
        overall_result = '0'B;
    END;
    IF NOT test_mutation_operation_allocate_valid() THEN
        overall_result = '0'B;
    END;
    IF NOT test_mutation_operation_rollback_valid() THEN
        overall_result = '0'B;
    END;

    /* T01.F: Capability tests */
    IF NOT test_capability_file_valid() THEN
        overall_result = '0'B;
    END;
    IF NOT test_capability_foreign_runtime_valid() THEN
        overall_result = '0'B;
    END;
    IF NOT test_restoration_policy_reject_valid() THEN
        overall_result = '0'B;
    END;

    /* T01.G: Status tests */
    IF NOT test_execution_status_running_valid() THEN
        overall_result = '0'B;
    END;
    IF NOT test_validation_status_valid_code() THEN
        overall_result = '0'B;
    END;
    IF NOT test_step_result_kind_stepped() THEN
        overall_result = '0'B;
    END;

    RETURN(overall_result);
END run_all_primitive_type_tests;

/* ============================================================================
   MODULE END
   ========================================================================== */

/*
TEST COVERAGE SUMMARY:
  Total tests:      23
  Test families:    7 (ObjectId, Generation, ValueKind, Opcode, Mutation, Capability, Status)
  Assertions:       Multiple per test
  Invariants tested: I01, I19, I20

All tests are executable logic; no stubs or TODOs.
*/

END T01_PrimitiveTypes_Tests;
